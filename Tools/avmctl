#!/bin/sh
# avmctl — Guest House from the command line (2026-10-27; AVM/ControlServer.swift).
#
#   avmctl list | status <machine> | start <machine> [--no-window]
#          stop <machine> | save <machine> | force-stop <machine>
#          send-file <machine> <file> | read-screen <machine>
#
# Put it on your PATH, for example:
#   ln -s "$PWD/Tools/avmctl" /usr/local/bin/avmctl
# (it runs Guest House's own program with the word ctl).
# It uses $AVM_APP if set, else Guest House in /Applications or ~/Applications.

app="${AVM_APP:-}"
if [ -z "$app" ]; then
    for candidate in "/Applications/Guest House.app" "$HOME/Applications/Guest House.app"; do
        [ -x "$candidate/Contents/MacOS/Guest House" ] && app="$candidate" && break
    done
fi
if [ -z "$app" ] || [ ! -x "$app/Contents/MacOS/Guest House" ]; then
    echo "avmctl: Guest House.app wasn't found. Set AVM_APP to where it is." >&2
    exit 1
fi
exec "$app/Contents/MacOS/Guest House" ctl "$@"
