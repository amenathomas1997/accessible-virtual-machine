+/*
+ * AVM: a machine's sound straight from the card to a unix datagram socket
+ * (2026-11-04), for the iPhone receiver. Taking it after the Mac's output
+ * won't do: with the MacBook's lid closed that output stops asking for sound,
+ * the card stops moving it, and so does a capture. So this has its own clock,
+ * the Mac's output is left off (the room stays quiet while someone listens
+ * elsewhere) and each datagram is
+ *   u32 rate, in hertz, then 16-bit stereo samples, little-endian.
+ * The guest's own volume and AVM's ear levels apply, as they would at the Mac.
+ * A socket nobody reads drops sound; the machine never waits for it.
+ */
+#define AVM_STREAM_TICK_NS (5 * SCALE_MS)
+#define AVM_STREAM_MAX_NS  (20 * SCALE_MS)
+#define AVM_STREAM_MAX_IN  3840
+/* macOS holds a unix datagram to 2048 bytes (net.local.dgram.maxdgram). */
+#define AVM_STREAM_MAX_FRAMES 500
+
+static void hda_audio_stream_out(HDAAudioStream *st, const uint8_t *in, int len)
+{
+    HDAAudioState *a = st->state;
+    int bytes = st->as.fmt == AUDIO_FORMAT_S32 ? 4 : 2;
+    int channels = st->as.nchannels;
+    int frames = len / (bytes * channels);
+    uint32_t out[1 + AVM_STREAM_MAX_FRAMES];
+    int16_t *samples = (int16_t *)&out[1];
+    int64_t left = st->mute_left ? 0
+                 : (int64_t)st->gain_left * a->avm_left * 256 / (QEMU_HDA_AMP_STEPS * 100);
+    int64_t right = st->mute_right ? 0
+                  : (int64_t)st->gain_right * a->avm_right * 256 / (QEMU_HDA_AMP_STEPS * 100);
+    int i, c;
+
+    frames = MIN(frames, AVM_STREAM_MAX_FRAMES);
+    out[0] = st->as.freq;
+    for (i = 0; i < frames; i++) {
+        int32_t pair[2];
+        for (c = 0; c < 2; c++) {
+            const uint8_t *from = in + i * bytes * channels
+                                  + MIN(c, channels - 1) * bytes;
+            if (bytes == 4) {
+                /* The high half: 32 bits down to 16. */
+                pair[c] = (int16_t)(from[2] | (from[3] << 8));
+            } else {
+                pair[c] = (int16_t)(from[0] | (from[1] << 8));
+            }
+        }
+        samples[i * 2] = (int16_t)(pair[0] * left / 256);
+        samples[i * 2 + 1] = (int16_t)(pair[1] * right / 256);
+    }
+    /* Non-blocking; a full socket loses this piece, and that's all. */
+    (void)!send(a->avm_stream_fd, out, 4 + frames * 4, 0);
+}
+
+static void hda_audio_stream_tick(void *opaque)
+{
+    HDAAudioState *a = opaque;
+    int64_t now = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+    int i;
+
+    if (a->avm_stream_fd < 0) {
+        return;
+    }
+    for (i = 0; i < ARRAY_SIZE(a->st); i++) {
+        HDAAudioStream *st = &a->st[i];
+        uint8_t buf[AVM_STREAM_MAX_IN];
+        int64_t elapsed;
+        int frame, due;
+
+        if (!st->node || !st->output || !st->running ||
+            (st->as.fmt != AUDIO_FORMAT_S16 && st->as.fmt != AUDIO_FORMAT_S32) ||
+            st->as.nchannels < 1) {
+            continue;
+        }
+        elapsed = MIN(now - st->avm_last_ns, AVM_STREAM_MAX_NS);
+        frame = st->as.nchannels * (st->as.fmt == AUDIO_FORMAT_S32 ? 4 : 2);
+        due = muldiv64(elapsed, st->as.freq, NANOSECONDS_PER_SECOND);
+        due = MIN(due, sizeof(buf) / frame);
+        due = MIN(due, AVM_STREAM_MAX_FRAMES);
+        if (due <= 0) {
+            continue;
         }
+        /* Forward by whole frames, so a rate that doesn't divide evenly keeps time. */
+        st->avm_last_ns = now - (elapsed - muldiv64(due, NANOSECONDS_PER_SECOND, st->as.freq));
+        if (hda_codec_xfer(&a->hda, st->stream, true, buf, due * frame)) {
+            hda_audio_stream_out(st, buf, due * frame);
+        }
     }
+    timer_mod_anticipate_ns(a->avm_stream_timer, now + AVM_STREAM_TICK_NS);
 }
 
+static void hda_audio_stream_restart(HDAAudioState *a)
+{
+    int64_t now = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+    int i;
+
+    for (i = 0; i < ARRAY_SIZE(a->st); i++) {
+        HDAAudioStream *st = &a->st[i];
+
+        st->avm_last_ns = now;
+        if (st->node && st->output && st->voice.out) {
+            /* Off while the socket has it; back on, as the guest left it. */
+            AUD_set_active_out(st->voice.out, a->avm_stream_fd < 0 && st->running);
+        }
+    }
+    if (a->avm_stream_fd >= 0) {
+        timer_mod_anticipate_ns(a->avm_stream_timer, now + AVM_STREAM_TICK_NS);
+    } else {
+        timer_del(a->avm_stream_timer);
+    }
+}
+
+static char *hda_audio_get_stream(Object *obj, Error **errp)
+{
+    return g_strdup(HDA_AUDIO(obj)->avm_stream_path ?: "");
+}
+
+static void hda_audio_set_stream(Object *obj, const char *path, Error **errp)
+{
+    HDAAudioState *a = HDA_AUDIO(obj);
+    int fd = -1;
+
+    if (path[0]) {
+        struct sockaddr_un addr = { .sun_family = AF_UNIX };
+
+        if (strlen(path) >= sizeof(addr.sun_path)) {
+            error_setg(errp, "avm-stream: the path is too long");
+            return;
+        }
+        strcpy(addr.sun_path, path);
+        fd = socket(AF_UNIX, SOCK_DGRAM, 0);
+        if (fd < 0 || connect(fd, (struct sockaddr *)&addr, sizeof(addr)) < 0 ||
+            fcntl(fd, F_SETFL, O_NONBLOCK) < 0) {
+            error_setg_errno(errp, errno, "avm-stream: no socket at %s", path);
+            if (fd >= 0) {
+                close(fd);
+            }
+            return;
+        }
+    }
+    if (a->avm_stream_fd >= 0) {
+        close(a->avm_stream_fd);
+    }
+    a->avm_stream_fd = fd;
+    g_free(a->avm_stream_path);
+    a->avm_stream_path = g_strdup(path);
+    if (!a->avm_stream_timer) {
+        a->avm_stream_timer = timer_new_ns(QEMU_CLOCK_VIRTUAL, hda_audio_stream_tick, a);
+    }
+    hda_audio_stream_restart(a);
+}
